<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_rs_fx_fetch" model="ir.cron">
        <field name="name">Serbian FX: fetch exchange rates</field>
        <field name="model_id" ref="model_rs_fx_rate"/>
        <field name="state">code</field>
        <field name="code">model._cron_fetch_rates()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now().replace(hour=7, minute=30, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
